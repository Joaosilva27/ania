{
  "name": "ania",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform web --output-dir web-build",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "seed": "tsx scripts/seed-recipes.ts",
    "seed:dry": "tsx scripts/seed-recipes.ts --dry-run",
    "recipes:import": "node scripts/import-recipes.mjs --refresh",
    "recipes:images": "node scripts/import-recipes.mjs --images-only",
    "images:build": "node scripts/build-image-registry.mjs",
    "prices:serve": "node price-service/server.mjs",
    "icons": "node scripts/make-icon.mjs",
    "verify:icons": "tsx scripts/verify-icons.ts",
    "native:prebuild": "expo prebuild"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.0",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.5",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "^2.4.1",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.1.0",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.10.0",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "^0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "firebase-admin": "^13.4.0",
    "jest": "^29.7.0",
    "sharp": "^0.35.5",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}
