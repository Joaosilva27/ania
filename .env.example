# ---------------------------------------------------------------------------
# Ania — environment configuration
# Copy to .env and fill in. Never commit .env.
# The app runs in a clearly-labelled local preview mode while these are empty.
# ---------------------------------------------------------------------------

# Firebase Web API key (Firebase console -> Project settings -> Your apps -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Google OAuth (Google Cloud console -> APIs & Services -> Credentials)
# Create "OAuth client ID" entries of type "iOS" and "Android", plus a
# "Web application" client (the web client ID is the one used as the
# idToken audience below).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional: used by scripts/seed-recipes.ts (firebase-admin service account)
FIREBASE_SERVICE_ACCOUNT=./service-account.json
